# Copy to /etc/stonkfolio/keeper.env (chmod 600) and fill in real values.
# Never commit a filled-in copy of this file.

# A paid RPC provider. The keeper sends many transactions per round; free
# tiers throttle getProgramAccounts and confirmation polling.
STONKFOLIO_RPC_URL=https://your-provider.example.com/your-key

# Helius DAS endpoint for holder snapshots (public mainnet RPCs refuse
# getProgramAccounts for SPL Token). Omit only on devnet/local validators.
STONKFOLIO_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key

# The dedicated keeper key: fee claimer, pool creator and distributor root
# authority for every coin in the deployment. Keep only operating SOL in it.
# Owner-only (chmod 600, owned by the stonkfolio user).
STONKFOLIO_KEEPER_KEYPAIR=/etc/stonkfolio/keeper.json

# Deployment file written by scripts/launch/* (fee tier configs and pools).
STONKFOLIO_DEPLOYMENT=/opt/stonkfolio/deployments/mainnet.json

# Per-coin keeper state and the process lock. Holds round sampling secrets and
# swap-wallet keys until they're used — keep it private, durable and backed up.
# The systemd unit creates it (StateDirectory=stonkfolio).
STONKFOLIO_STATE_DIR=/var/lib/stonkfolio

# Where round artifact bundles are published before each round is committed.
# Either a local clone of the public artifacts repository (pushed to REMOTE)...
STONKFOLIO_ARTIFACT_REPO_DIR=/opt/stonkfolio-artifacts
STONKFOLIO_ARTIFACT_REMOTE=origin
# ...or a plain directory served some other way (add it to ReadWritePaths in the unit):
# STONKFOLIO_ARTIFACT_DIR=/var/www/stonkfolio-artifacts

# Receives the platform revenue share (10% of each coin's fee revenue).
# Defaults to the compiled-in wallet in keeper/config.ts; set only to override.
PLATFORM_REVENUE_ADDRESS=EkARrDbTFynVpxQAxY11URkdxznccbzhEaexuX4GVw63

# Only after rotating distributor root authority to a new key: the original
# key the distributors were created under (their addresses derive from it).
# STONKFOLIO_DISTRIBUTOR_CREATOR=

# Tunables (fee split, thresholds, round cadence) are compiled into
# keeper/config.ts, so changing them requires a rebuild and redeploy.
